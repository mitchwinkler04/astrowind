---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import ContactUs from '~/components/widgets/Contact.astro';
import Features2 from '~/components/widgets/Features2.astro';

const metadata = {
  title: 'Contact',
};
---

<Layout metadata={metadata}>
  <!-- HeroText Widget ******************* -->

  <HeroText tagline="Contact Us" title="Let's talk!" />

  <ContactUs
    id="form"
    title="Send us a message"
    subtitle="Fill out the form below and we'll get back to you within one business day. Prefer to talk? Give us a call — we love hearing from our customers."
    inputs={[
      {
        type: 'text',
        name: 'name',
        label: 'Your Name',
      },
      {
        type: 'email',
        name: 'email',
        label: 'Email Address',
      },
      {
        type: 'text',
        name: 'phone',
        label: 'Phone Number (optional)',
      },
    ]}
    textarea={{
      label: 'Tell us about your project',
      placeholder: 'Describe what you need help with. The more detail, the better!',
    }}
    disclaimer={{
      label:
        'By submitting this form, you agree that we may contact you regarding your inquiry.',
    }}
    description="We typically respond within one business day. For urgent matters, please call us directly."
  />

  <!-- Features2 Widget ************** -->

  <Features2
    title="Other ways to reach us"
    items={[
      {
        title: 'Phone & Text',
        description: `Call or text us at <strong>(555) 123-4567</strong>. Available Monday–Friday, 8am–6pm. We also check messages on weekends.`,
        icon: 'tabler:phone',
      },
      {
        title: 'Email',
        description:
          'Email us at <strong>hello@yourbusiness.com</strong>. We aim to respond to all emails within one business day.',
        icon: 'tabler:mail',
      },
      {
        title: 'Service Area',
        description:
          'We serve <strong>[Your City]</strong> and surrounding communities within [X] miles. Not sure if we cover your area? Just ask!',
        icon: 'tabler:map-pin',
      },
      {
        title: 'Hours of Operation',
        description:
          '<strong>Monday–Friday:</strong> 8am–6pm<br /><strong>Saturday:</strong> 9am–3pm<br /><strong>Sunday:</strong> By appointment',
        icon: 'tabler:clock',
      },
      {
        title: 'Emergency Service',
        description:
          'For urgent situations, call our emergency line at <strong>(555) 987-6543</strong>. We do our best to respond quickly.',
        icon: 'tabler:alert-triangle',
      },
      {
        title: 'Follow Us',
        description:
          'Stay up to date with tips, before/after photos, and special offers by following us on Facebook and Instagram.',
        icon: 'tabler:brand-facebook',
      },
    ]}
  />
</Layout>
