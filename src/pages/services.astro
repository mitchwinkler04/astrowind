---
import CallToAction from '~/components/widgets/CallToAction.astro';
import Content from '~/components/widgets/Content.astro';
import Features2 from '~/components/widgets/Features2.astro';
import Hero from '~/components/widgets/Hero.astro';
import Testimonials from '~/components/widgets/Testimonials.astro';
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'Services',
};
---

<Layout metadata={metadata}>
  <!-- Hero Widget ******************* -->

  <Hero
    tagline="Our Services"
    title="Everything you need, all in one place"
    subtitle="From routine maintenance to complex projects, we have the skills and experience to get the job done right the first time."
    actions={[{ variant: 'primary', text: 'Get a Free Quote', href: '/contact' }]}
    image={{
      src: 'https://images.unsplash.com/photo-1581091226825-a6a2a5aee158?ixlib=rb-4.0.3&auto=format&fit=crop&w=1740&q=80',
      alt: 'Professional at work',
    }}
  />

  <!-- Features2 Widget ************** -->

  <Features2
    title="What we offer"
    subtitle="Replace these with your actual services. Each card can include a title, description, and icon."
    columns={3}
    items={[
      {
        title: 'Service One',
        description:
          'Describe your first service here. What does it include? Who is it for? What problem does it solve for your customers?',
        icon: 'tabler:tool',
      },
      {
        title: 'Service Two',
        description:
          'Describe your second service here. Highlight the key benefits and what makes your approach different from competitors.',
        icon: 'tabler:settings',
      },
      {
        title: 'Service Three',
        description:
          'Describe your third service here. Focus on outcomes — what will the customer experience after the work is complete?',
        icon: 'tabler:star',
      },
      {
        title: 'Service Four',
        description:
          'Add as many services as you need. You can also add or remove cards to match your actual service offerings.',
        icon: 'tabler:home',
      },
      {
        title: 'Service Five',
        description:
          'Use specific, customer-friendly language. Avoid jargon and explain each service as if speaking to someone unfamiliar with your industry.',
        icon: 'tabler:truck',
      },
      {
        title: 'Emergency / Rush Service',
        description:
          'When you need us fast, we\'re there. We offer expedited scheduling for urgent situations — just let us know when you call.',
        icon: 'tabler:clock-bolt',
      },
    ]}
  />

  <!-- Content Widget **************** -->

  <Content
    isReversed
    items={[
      {
        title: 'Thorough Assessment',
        description:
          'Every job starts with a careful evaluation of your specific needs. We never cut corners or make assumptions.',
        icon: 'tabler:clipboard-list',
      },
      {
        title: 'Quality Materials',
        description:
          'We use only trusted, high-quality materials and tools so the results last and you get real value for your investment.',
        icon: 'tabler:certificate',
      },
      {
        title: 'Clean Worksite',
        description:
          'We treat your property with respect. Every job ends with a thorough cleanup — we leave things better than we found them.',
        icon: 'tabler:sparkles',
      },
      {
        title: 'Final Walkthrough',
        description:
          'Before we call any job complete, we walk you through the finished work and make sure you\'re 100% satisfied.',
        icon: 'tabler:check',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1560472354-b33ff0c44a43?ixlib=rb-4.0.3&auto=format&fit=crop&w=1726&q=80',
      alt: 'Quality workmanship',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">Our process</h3>
      We follow a proven, step-by-step process on every job to ensure consistent, high-quality results.
    </Fragment>
  </Content>

  <!-- Content Widget **************** -->

  <Content
    isAfterContent
    items={[
      {
        title: 'Save Time',
        description:
          'Stop spending your weekends on tasks better left to the professionals. We handle it so you can focus on what matters most.',
        icon: 'tabler:clock',
      },
      {
        title: 'Save Money',
        description:
          'DIY mistakes can be costly. Our upfront pricing and expert execution often saves customers money in the long run.',
        icon: 'tabler:coin',
      },
      {
        title: 'Peace of Mind',
        description:
          'Know the job is done right, by licensed professionals who stand behind their work with a satisfaction guarantee.',
        icon: 'tabler:shield-check',
      },
      {
        title: 'Local Support',
        description:
          'We\'re a local business — easy to reach, quick to respond, and invested in the health of our community.',
        icon: 'tabler:map-pin',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1556742049-0cfed4f6a45d?ixlib=rb-4.0.3&auto=format&fit=crop&w=1740&q=80',
      alt: 'Benefits of hiring us',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">Why hire a professional?</h3>
    </Fragment>
  </Content>

  <!-- Testimonials Widget *********** -->

  <Testimonials
    title="Hear from our customers"
    testimonials={[
      {
        testimonial: `They handled our [service] project from start to finish and the results were outstanding. On time, on budget, and the quality of work was top-notch.`,
        name: 'Robert K.',
        job: '[Your City] Homeowner',
        image: {
          src: 'https://images.unsplash.com/photo-1500648767791-00dcc994a43e?ixlib=rb-4.0.3&auto=format&fit=crop&w=930&q=80',
          alt: 'Robert K.',
        },
      },
      {
        testimonial: `I called three companies before choosing [Your Business Name]. Their quote was fair, their communication was excellent, and they delivered exactly what they promised.`,
        name: 'Linda P.',
        job: 'Local Restaurant Owner',
        image: {
          src: 'https://images.unsplash.com/photo-1494790108755-2616b612b786?ixlib=rb-4.0.3&auto=format&fit=crop&w=774&q=80',
          alt: 'Linda P.',
        },
      },
      {
        testimonial: `Professional, knowledgeable, and genuinely nice people. They explained every step and made sure I understood what they were doing and why. Will absolutely use them again.`,
        name: 'Carlos M.',
        job: '[Your City] Resident',
        image: {
          src: 'https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?ixlib=rb-4.0.3&auto=format&fit=crop&w=930&q=80',
          alt: 'Carlos M.',
        },
      },
    ]}
    callToAction={{
      text: 'Read more reviews',
      href: '#',
      icon: 'tabler:chevron-right',
    }}
  />

  <!-- CallToAction Widget *********** -->

  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: 'Get a Free Quote',
        href: '/contact',
      },
    ]}
    title="Ready to get started?"
    subtitle="Contact us today for a free consultation and no-obligation estimate. We'd love to help."
  />
</Layout>
