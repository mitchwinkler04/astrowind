---
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import Stats from '~/components/widgets/Stats.astro';
import Features from '~/components/widgets/Features.astro';
import Steps2 from '~/components/widgets/Steps2.astro';
import Features2 from '~/components/widgets/Features2.astro';
import Content from '~/components/widgets/Content.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'About Us',
};
---

<Layout metadata={metadata}>

  <!-- ══ HERO ══ -->
  <Hero
    tagline="About WW Lawncare & Services"
    image={{
      src: 'https://images.unsplash.com/photo-1600880292203-757bb62b4baf?ixlib=rb-4.0.3&auto=format&fit=crop&w=2070&q=80',
      alt: 'WW Lawncare team at work',
    }}
  >
    <Fragment slot="title">
      Local, professional,<br />
      <span class="text-accent dark:text-white">built on precision.</span>
    </Fragment>

    <Fragment slot="subtitle">
      WW Lawncare &amp; Services was founded on one simple belief: your lawn and home deserve the same care and attention
      we'd give our own. We're a local lawn care and property services company — not a franchise, not a call center.
      Just real people who take real pride in the work we do in our community.
    </Fragment>
  </Hero>


  <!-- ══ STATS ══ -->
  <Stats
    title="We show up and deliver"
    stats={[
      { title: 'Lawns Maintained', amount: '500+' },
      { title: 'Happy Customers', amount: '200+' },
      { title: 'Jobs Completed', amount: '1,200+' },
      { title: '5-Star Reviews', amount: '150+' },
    ]}
  />


  <!-- ══ OUR STORY ══ -->
  <Content
    isReversed
    tagline="Our Story"
    title="Why we started"
    items={[
      {
        title: 'Frustrated by unreliable services',
        description:
          'Like a lot of homeowners, our founder grew tired of lawn care companies that no-showed, did sloppy work, and overcharged without warning. WW Lawncare was the answer.',
      },
      {
        title: 'Built from the ground up, locally',
        description:
          "We started with a single mower, one truck, and a commitment to doing things right. Every dollar of growth came from referrals — customers telling neighbors about us.",
      },
      {
        title: 'Still local, still personal',
        description:
          "We haven't grown into a faceless franchise and we never plan to. Our customers know our names. We know their yards. That relationship matters.",
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1521737604893-d14cc237f11d?ixlib=rb-4.0.3&auto=format&fit=crop&w=2084&q=80',
      alt: 'Team working together',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">"Precision Meets Nature"</h3>
      Our slogan isn't just marketing. Precision means showing up on time, cutting clean, and charging what we quoted.
      Nature means respecting your property and the environment we work in every day.
    </Fragment>
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-green-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>


  <!-- ══ VALUES ══ -->
  <Steps2
    title="What we stand for"
    subtitle="These aren't slogans on a poster — they're the standards we hold ourselves to on every single job."
    items={[
      {
        title: 'Honesty',
        description:
          "We quote a fair price and stick to it. If something comes up mid-job, we call you before we do extra work — not after. You'll never get an unexpected invoice.",
      },
      {
        title: 'Precision',
        description:
          "Sloppy work isn't in our vocabulary. Every edge is straight, every window streak-free, every bed level. Details matter to us because they matter to you.",
      },
      {
        title: 'Reliability',
        description:
          'We show up. Every time. On time. If something prevents it, we call — we never just ghost. Reliability is the hardest thing to find in this industry and we protect it fiercely.',
      },
      {
        title: 'Community',
        description:
          "This is our town too. We sponsor local events, hire locally, and take pride in making our neighborhood look its best — one lawn at a time.",
      },
    ]}
  />


  <!-- ══ MEET THE TEAM ══ -->
  <Features
    tagline="The Team"
    title="People who take pride in the work"
    subtitle="Small team, high standards. You'll see the same friendly faces on every visit."
    items={[
      {
        title: '[Owner Name], Founder & Owner',
        description:
          "Started WW Lawncare after years in the landscape industry. Personally oversees every job and is never more than a phone call away.",
        icon: 'tabler:user-circle',
      },
      {
        title: '[Name], Lead Crew Member',
        description:
          'Handles lawn mowing and mulching with meticulous attention to detail. Customers request them by name.',
        icon: 'tabler:user-circle',
      },
      {
        title: '[Name], Window Washing Specialist',
        description:
          'Streak-free results, every time. Experienced working on single and multi-story properties safely and efficiently.',
        icon: 'tabler:user-circle',
      },
    ]}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-green-50 dark:bg-transparent"></div>
    </Fragment>
  </Features>


  <!-- ══ WHY US ══ -->
  <Content
    tagline="Why WW Lawncare"
    title="The difference you'll notice"
    items={[
      {
        title: 'No contracts or commitments',
        description:
          'Book when you need us, skip when you don\'t. There are no lock-ins, cancellation fees, or minimum commitments. Ever.',
        icon: 'tabler:file-off',
      },
      {
        title: 'Flat-rate mowing, always $40',
        description:
          'While other companies measure and bid on every lawn, we keep it simple. A standard residential lawn is $40 — no games.',
        icon: 'tabler:receipt',
      },
      {
        title: 'Fast response, fast quotes',
        description:
          "Message us and we respond same day. Mulching and window washing quotes typically come back within a few hours.",
        icon: 'tabler:message-bolt',
      },
      {
        title: 'Easy Venmo payments',
        description:
          'Pay after the job is done via Venmo — quick, simple, no cash or check required.',
        icon: 'tabler:brand-cashapp',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1558618666-fcd25c85cd64?ixlib=rb-4.0.3&auto=format&fit=crop&w=1740&q=80',
      alt: 'Freshly mowed lawn',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">Simple. Reliable. Worth it.</h3>
    </Fragment>
  </Content>


  <!-- ══ SERVICE AREA ══ -->
  <Features2
    title="Where we work"
    tagline="Service Area"
    subtitle="We serve the local area and surrounding communities. Not sure if we cover your address? Just ask — we're happy to check."
    columns={3}
    items={[
      {
        title: '[Your City]',
        description: 'Our home base. We serve all neighborhoods, subdivisions, and streets.',
      },
      {
        title: '[Nearby Town 1]',
        description: 'Full service available — mowing, mulching, and window washing.',
      },
      {
        title: '[Nearby Town 2]',
        description: 'Add or remove towns to match your real service area.',
      },
    ]}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-green-50 dark:bg-transparent"></div>
    </Fragment>
  </Features2>


  <!-- ══ CONTACT QUICK STRIP ══ -->
  <Features2
    title="Reach us directly"
    tagline="Get in Touch"
    columns={2}
    items={[
      {
        title: 'Call or Text',
        description: 'Reach us at <strong>(555) 000-0000</strong> — Mon–Fri 8am–6pm, Sat 9am–3pm.',
        icon: 'tabler:phone',
      },
      {
        title: 'Email or Message',
        description: 'Send us a note at <strong>hello@wwlawncare.com</strong> or use the chat on our homepage.',
        icon: 'tabler:mail',
      },
    ]}
  />


  <!-- ══ FINAL CTA ══ -->
  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: 'Book an Appointment',
        href: '/#booking',
        icon: 'tabler:calendar',
      },
      {
        variant: 'secondary',
        text: 'View Our Services',
        href: '/services',
        icon: 'tabler:list',
      },
    ]}
  >
    <Fragment slot="title">Ready to work with us?</Fragment>
    <Fragment slot="subtitle">
      Book a lawn mowing for $40, or reach out for a free quote on mulching or window washing.
    </Fragment>
  </CallToAction>

</Layout>
