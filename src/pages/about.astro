---
import Features2 from '~/components/widgets/Features2.astro';
import Features3 from '~/components/widgets/Features3.astro';
import Hero from '~/components/widgets/Hero.astro';
import Stats from '~/components/widgets/Stats.astro';
import Steps2 from '~/components/widgets/Steps2.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'About Us',
};
---

<Layout metadata={metadata}>
  <!-- Hero Widget ******************* -->

  <Hero
    tagline="About Us"
    image={{
      src: 'https://images.unsplash.com/photo-1600880292203-757bb62b4baf?ixlib=rb-4.0.3&auto=format&fit=crop&w=2070&q=80',
      alt: 'Our team',
    }}
  >
    <Fragment slot="title">
      A local business <br />
      <span class="text-accent dark:text-white">built on trust</span>
    </Fragment>

    <Fragment slot="subtitle">
      We started [Your Business Name] in [Year] with a simple idea: deliver honest, high-quality [service] at fair prices — and treat every customer the way we'd want to be treated. That philosophy hasn't changed. Replace this with your own story and it will make a real connection with potential customers.
    </Fragment>
  </Hero>

  <!-- Stats Widget ****************** -->

  <Stats
    title="By the numbers"
    stats={[
      { title: 'Years in Business', amount: '[X]+' },
      { title: 'Customers Served', amount: '[X]K+' },
      { title: 'Projects Completed', amount: '[X]K+' },
      { title: '5-Star Reviews', amount: '[X]+' },
    ]}
  />

  <!-- Features3 Widget ************** -->

  <Features3
    title="Meet our team"
    subtitle="Replace these cards with photos and bios of your actual team members. Putting real faces to your business builds trust and makes you more approachable."
    columns={3}
    isBeforeContent={true}
    items={[
      {
        title: '[Owner Name], Owner',
        description:
          '[Owner Name] founded [Your Business Name] in [Year] after [X] years working in the [industry]. [He/She/They] is passionate about delivering exceptional results and building long-term relationships with customers.',
        icon: 'tabler:user',
      },
      {
        title: '[Team Member], Lead [Role]',
        description:
          '[Team Member] has been with us since [Year] and brings [X] years of experience in [specialty]. Known for [a standout quality], [he/she/they] is a customer favorite.',
        icon: 'tabler:user',
      },
      {
        title: '[Team Member], [Role]',
        description:
          'Add as many team members as you\'d like. Customers love knowing who will be showing up to do the work — it adds a personal touch that larger companies can\'t match.',
        icon: 'tabler:user',
      },
    ]}
  />

  <!-- Steps2 Widget ****************** -->

  <Steps2
    title="Our values"
    subtitle="These aren't just words on a wall — they guide every decision we make and every job we take on."
    items={[
      {
        title: 'Integrity',
        description:
          'We tell you the truth, even when it\'s not what you want to hear. Honest assessments and transparent pricing are non-negotiable.',
      },
      {
        title: 'Quality Craftsmanship',
        description:
          'We take pride in our work. Every job gets our full attention and effort, whether it\'s a small repair or a major project.',
      },
      {
        title: 'Community',
        description:
          'We\'re your neighbors. We care about [Your City] and give back through [local sponsorships, volunteering, etc.]. When local businesses thrive, everyone benefits.',
      },
    ]}
  />

  <!-- Steps2 Widget ****************** -->

  <Steps2
    title="Our story"
    subtitle="How we got here — and where we're going."
    isReversed={true}
    callToAction={{
      text: 'Contact us',
      href: '/contact',
    }}
    items={[
      {
        title: 'Founded in [Year]',
        description: 'Describe how the business started. Was it a lifelong passion? A gap in the local market? A family tradition? This is your story — make it authentic.',
        icon: 'tabler:home',
      },
      {
        title: 'Growing our team',
        description:
          'As word spread and demand grew, we brought on more skilled professionals who share our commitment to quality. Today our team includes [X] full-time staff.',
        icon: 'tabler:users',
      },
      {
        title: 'Trusted by [Your City]',
        description:
          'Today, we\'re proud to be one of [Your City]\'s most trusted [service] providers. Our reputation is built on referrals — customers who love our work and tell their friends.',
        icon: 'tabler:star',
      },
    ]}
  />

  <!-- Features2 Widget ************** -->

  <Features2
    title="Service area"
    tagline="Find us"
    columns={3}
    items={[
      {
        title: '[Your City]',
        description: 'Our home base. We serve all neighborhoods in [Your City].',
      },
      {
        title: '[Nearby Town]',
        description: 'We regularly serve customers in [Nearby Town] and surrounding areas.',
      },
      {
        title: '[Another Town]',
        description: 'Add all the cities and towns you serve. Remove any that don\'t apply.',
      },
    ]}
  />

  <!-- Features2 Widget ************** -->

  <Features2
    title="Get in touch"
    tagline="Contact us"
    columns={2}
    items={[
      {
        title: 'Call or Text',
        description:
          'Reach us at [(555) 123-4567]. We answer calls Monday–Friday, [8am–5pm], and often on weekends too.',
        icon: 'tabler:phone',
      },
      {
        title: 'Email Us',
        description:
          'Send us a message at [hello@yourbusiness.com] and we\'ll respond within one business day.',
        icon: 'tabler:mail',
      },
    ]}
  />

  <!-- CallToAction Widget *********** -->

  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: 'Get a Free Quote',
        href: '/contact',
        icon: 'tabler:arrow-right',
      },
    ]}
    title="Let's work together"
    subtitle="We'd love to earn your business. Reach out today for a free, no-pressure consultation."
  />
</Layout>
