---
import Layout from '~/layouts/PageLayout.astro';

import Hero from '~/components/widgets/Hero.astro';
import Features from '~/components/widgets/Features.astro';
import Steps from '~/components/widgets/Steps.astro';
import Content from '~/components/widgets/Content.astro';
import Testimonials from '~/components/widgets/Testimonials.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import Stats from '~/components/widgets/Stats.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'Your Business Name — Professional Services in Your City',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <!-- Hero Widget ******************* -->

  <Hero
    actions={[
      {
        variant: 'primary',
        text: 'Get a Free Quote',
        href: '/contact',
        icon: 'tabler:arrow-right',
      },
      { text: 'Our Services', href: '/services' },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1497366216548-37526070297c?ixlib=rb-4.0.3&auto=format&fit=crop&w=2070&q=80',
      alt: 'Professional business team at work',
    }}
  >
    <Fragment slot="title">
      Trusted <span class="text-accent dark:text-white">Professional Services</span> for Your Community
    </Fragment>

    <Fragment slot="subtitle">
      <span class="hidden sm:inline">
        <span class="font-semibold">Your Business Name</span> has been serving [Your City] and the surrounding area since [Year].</span
      >
      <span class="block mb-1 sm:hidden font-bold text-blue-600">Serving [Your City] since [Year].</span>
      We deliver [your core service] with a commitment to quality, integrity, and customer satisfaction.
    </Fragment>
  </Hero>

  <!-- Features Widget *************** -->

  <Features
    id="features"
    tagline="Why Choose Us"
    title="What sets us apart"
    subtitle="We combine years of local expertise with a genuine commitment to every customer we serve."
    items={[
      {
        title: 'Licensed & Insured',
        description:
          'Fully licensed and insured for your peace of mind. We meet all local and state requirements so you never have to worry.',
        icon: 'tabler:shield-check',
      },
      {
        title: 'Local Expertise',
        description:
          'We know [Your City] inside and out. Our deep community roots mean faster response times and solutions tailored to local needs.',
        icon: 'tabler:map-pin',
      },
      {
        title: 'Upfront Pricing',
        description:
          'No hidden fees, no surprises. You get a clear, detailed quote before any work begins so you always know what to expect.',
        icon: 'tabler:receipt',
      },
      {
        title: 'Quality Guaranteed',
        description:
          'We stand behind every job with a satisfaction guarantee. If something is not right, we make it right — no questions asked.',
        icon: 'tabler:star',
      },
      {
        title: 'Fast Response',
        description:
          'We respect your time. Same-day and next-day appointments are often available, and we always show up when we say we will.',
        icon: 'tabler:clock',
      },
      {
        title: 'Years of Experience',
        description:
          'With [X]+ years serving [Your City], our team brings the expertise and know-how to handle any job, big or small.',
        icon: 'tabler:award',
      },
    ]}
  />

  <!-- Content Widget **************** -->

  <Content
    isReversed
    tagline="About Us"
    title="A local business you can count on"
    items={[
      {
        title: 'Community-focused',
        description:
          'We live and work here too. Supporting local businesses and neighbors is at the heart of everything we do.',
      },
      {
        title: 'Experienced team',
        description:
          'Our skilled professionals bring [X]+ years of combined experience and stay current on best practices in the industry.',
      },
      {
        title: 'Customer-first approach',
        description:
          'Every project is treated with the same care and attention we would give our own home or business.',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1521737604893-d14cc237f11d?ixlib=rb-4.0.3&auto=format&fit=crop&w=2084&q=80',
      alt: 'Team working together',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">Built on trust, driven by results</h3>
      We've helped hundreds of [Your City] residents and businesses with their [service] needs — and we'd love to help you too.
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- Steps Widget ****************** -->

  <Steps
    title="Getting started is easy"
    items={[
      {
        title: 'Step 1: <span class="font-medium">Contact Us</span>',
        description:
          'Call, email, or fill out our online form. Tell us about your project and we\'ll get back to you within one business day.',
        icon: 'tabler:phone',
      },
      {
        title: 'Step 2: <span class="font-medium">Free Consultation</span>',
        description:
          'We\'ll come to you (or meet virtually) to assess your needs and provide a detailed, no-obligation quote.',
        icon: 'tabler:clipboard-list',
      },
      {
        title: 'Step 3: <span class="font-medium">We Get to Work</span>',
        description:
          'Once you approve the quote, our team schedules and completes the job on time and on budget.',
        icon: 'tabler:tools',
      },
      {
        title: 'Enjoy the Results!',
        icon: 'tabler:check',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?ixlib=rb-4.0.3&auto=format&fit=crop&w=987&q=80',
      alt: 'Happy customer',
    }}
  />

  <!-- Testimonials Widget *********** -->

  <Testimonials
    title="What our customers say"
    subtitle="Don't just take our word for it — hear from the neighbors and businesses we've had the pleasure of serving."
    testimonials={[
      {
        testimonial: `[Your Business Name] did an amazing job. They were professional, on time, and the quality of work exceeded our expectations. I won't use anyone else!`,
        name: 'Jane D.',
        job: '[Your City] Homeowner',
        image: {
          src: 'https://images.unsplash.com/photo-1580489944761-15a19d654956?ixlib=rb-4.0.3&auto=format&fit=crop&w=930&q=80',
          alt: 'Jane D.',
        },
      },
      {
        testimonial: `Fair pricing, excellent work, and they cleaned up everything when they were done. Highly recommend to anyone in the area looking for [service].`,
        name: 'Mike T.',
        job: 'Local Business Owner',
        image: {
          src: 'https://images.unsplash.com/photo-1472099645785-5658abf4ff4e?ixlib=rb-4.0.3&auto=format&fit=crop&w=1740&q=80',
          alt: 'Mike T.',
        },
      },
      {
        testimonial: `I've used them twice now and both times were great. They took the time to explain everything clearly and never tried to upsell me on things I didn't need.`,
        name: 'Sarah M.',
        job: '[Your City] Resident',
        image: {
          src: 'https://images.unsplash.com/photo-1438761681033-6461ffad8d80?ixlib=rb-4.0.3&auto=format&fit=crop&w=1740&q=80',
          alt: 'Sarah M.',
        },
      },
    ]}
  />

  <!-- Stats Widget ****************** -->

  <Stats
    stats={[
      { title: 'Years in Business', amount: '[X]+' },
      { title: 'Happy Customers', amount: '[X]K+' },
      { title: 'Projects Completed', amount: '[X]K+' },
      { title: '5-Star Reviews', amount: '[X]+' },
    ]}
  />

  <!-- FAQs Widget ******************* -->

  <FAQs
    title="Frequently Asked Questions"
    subtitle="Have questions? We have answers. If you don't see what you're looking for, just give us a call."
    tagline="FAQs"
    classes={{ container: 'max-w-6xl' }}
    items={[
      {
        title: 'What areas do you serve?',
        description:
          'We primarily serve [Your City] and the surrounding communities within [X] miles, including [Nearby Town 1], [Nearby Town 2], and [Nearby Town 3]. Not sure if we cover your area? Give us a call and we\'ll let you know.',
      },
      {
        title: 'Do you offer free estimates?',
        description:
          'Yes! We provide free, no-obligation estimates for all projects. Contact us to schedule a time that works for you.',
      },
      {
        title: 'Are you licensed and insured?',
        description:
          'Absolutely. We are fully licensed in [Your State] and carry comprehensive liability insurance and workers\' compensation coverage. We\'re happy to provide proof of insurance upon request.',
      },
      {
        title: 'How quickly can you start my project?',
        description:
          'For most projects, we can schedule a start date within [X] business days of approving your quote. For urgent situations, we do our best to accommodate same-day or next-day service.',
      },
      {
        title: 'What payment methods do you accept?',
        description:
          'We accept cash, check, and all major credit cards. We also offer financing options for larger projects — ask us for details.',
      },
      {
        title: 'Do you stand behind your work?',
        description:
          'We offer a [X]-year workmanship warranty on all our services. If you\'re not satisfied, we\'ll make it right. Your happiness is our top priority.',
      },
    ]}
  />

  <!-- CallToAction Widget *********** -->

  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: 'Get a Free Quote',
        href: '/contact',
        icon: 'tabler:arrow-right',
      },
      {
        variant: 'secondary',
        text: 'Call Us Now',
        href: 'tel:+15551234567',
        icon: 'tabler:phone',
      },
    ]}
  >
    <Fragment slot="title">
      Ready to get started?
    </Fragment>

    <Fragment slot="subtitle">
      Contact us today for a free, no-obligation consultation. We're here to help — and we always pick up the phone.
    </Fragment>
  </CallToAction>
</Layout>
